{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "marrakech": {
      "root": "artifacts/marrakech",
      "framework": "vite"
    },
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/vercel.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/socket.io(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "marrakech"
      }
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}